# ==============================================================================
# XFORCE Construction Ltd / X-FORCE BRICKS
# Production & Local Environment Configuration Template
# ==============================================================================
# Security Policy:
# - NEVER commit real API keys, passwords, or service-role keys to source control.
# - Variables starting with VITE_ are embedded into the client-side browser bundle.
# - Variables WITHOUT VITE_ are strictly server-side only and never exposed to the client.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend Configuration
# ------------------------------------------------------------------------------
# Safe for client-side browser bundle:
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT:
# Used only in server-side functions / migrations to bypass RLS for administrative jobs.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ------------------------------------------------------------------------------
# 2. Artificial Intelligence Configuration (Server-Side Proxy)
# ------------------------------------------------------------------------------
# Used by Express server /api/ai/generate proxy route. Never bundled to client.
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 3. Payment Gateway Configuration (Paystack)
# ------------------------------------------------------------------------------
# Safe public key for browser checkout popup (pk_live_... or pk_test_...)
VITE_PAYSTACK_PUBLIC_KEY="pk_test_your-paystack-public-key"

# ------------------------------------------------------------------------------
# 4. Host & Application Runtime Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="production"
APP_URL="https://your-domain.vercel.app"


